# 部署時複製成 .env.production 並填入實際值（此檔不含機密，僅範本）
# 用法：docker run --env-file .env.production ...

# Maximo proxy 服務帳號（server-only；base64(user:pass)）— 務必改用最小權限服務帳號
MAX_AUTH=

# Maximo 後端
NEXT_PUBLIC_API_BASE_URL=http://hl.webtw.xyz
NEXT_PUBLIC_MAX_API_PATH=/maximo/oslc/script

# 前端網域（CORS 用；部署網域，例 https://hlmobile.webtw.xyz）；留空則同源
NEXT_PUBLIC_FRONTEND_ORIGIN=

# Session 簽章金鑰（無狀態 httpOnly cookie）— 換成高強度隨機值：openssl rand -hex 32
SESSION_SECRET=

# 健康檢查 /api/health/set 的 admin token
HEALTH_ADMIN_TOKEN=

# Ollama（AI 故障建議）
OLLAMA_URL=http://ollama.webtw.xyz:11434
