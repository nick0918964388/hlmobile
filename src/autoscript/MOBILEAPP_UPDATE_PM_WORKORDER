                //laborSet.setWhere("LABORCODE = '" + labor.laborCode + "' AND REGULARHRS = " + labor.hours);
                //if (!laborSet.isEmpty()) {
                //    laborMbo = laborSet.moveFirst();
                //} else {
                laborMbo = laborSet.add();
                //}
            }

            // 設置或更新勞工資源欄位
            if (laborMbo.toBeAdded()) {
                logger.info(title + "3");
                laborMbo.setValue("LABORCODE", labor.laborCode);
                laborMbo.setValue("REGULARHRS", labor.hours);
