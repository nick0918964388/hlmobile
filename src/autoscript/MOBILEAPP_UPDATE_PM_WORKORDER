// 執行SQL更新操作
function executeUpdate(sql) {
    var conn = null;
    var stmt = null;
    var affectedRows = 0;
    var conKey = null;
    var dbs = null;
    try {
        logger.info(title + "執行SQL更新: " + sql);
        conKey = userInfo.getConnectionKey();
        logger.info(title + "update 1");
        conn = MXServer.getMXServer().getDBManager().getConnection(conKey);
        logger.info(title + "update 2");
        stmt = conn.createStatement();
        logger.info(title + "update 3");
        // 執行SQL更新
        affectedRows = stmt.executeUpdate(sql);
        logger.info(title + "SQL更新影響的行數: " + affectedRows);

        return affectedRows;
    } catch (e) {
        logger.error(title + "執行SQL更新時發生錯誤: " + e);
        throw e;
    } finally {
