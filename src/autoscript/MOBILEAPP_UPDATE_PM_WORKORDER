            var toolId = String(tool.id || "");
            logger.info(title + "處理工具資源，ID: " + toolId + ", 狀態: " + status);

            // 1. 刪除資源
            if (status === 'delete') {
                var del = findMboById(toolSet, "TOOLTRANSID", toolId);
                if (del != null) {
                    del.delete();
                    logger.info(title + "已刪除工具資源 [ID: " + toolId + "]");
                }
                continue;
            }

            // 2. 更新既有或新增
            var isNew = status === 'new' || toolId.indexOf("T_") === 0 || toolId === "";
            var mbo = isNew ? null : findMboById(toolSet, "TOOLTRANSID", toolId);

            if (mbo == null) {
                mbo = toolSet.add();
                logger.info(title + "新增工具資源（MBO add）");
            } else {
                logger.info(title + "更新現有工具資源 [ID: " + toolId + "]");
            }

            // ITEMNUM 走驗證，DESCRIPTION 由 item 自動帶入
            mbo.setValue("ITEMNUM", tool.toolCode, MboConstants.NOACCESSCHECK);
            // TOOLTRANS 儲存室欄位為 LOCATION（前端需附帶 tool.location）
            if (tool.location) {
                mbo.setValue("LOCATION", tool.location, MboConstants.NOACCESSCHECK);
            }
            mbo.setValue("TOOLQTY", tool.quantity, MboConstants.NOACCESSCHECK);
            if (tool.hours) {
                mbo.setValue("TOOLHRS", tool.hours, MboConstants.NOACCESSCHECK);
            }
        }
    } catch (e) {
        logger.error(title + "更新工具資源時發生錯誤: " + e);
        throw e;
    }
}